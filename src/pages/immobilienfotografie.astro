---
import { ogImageFor } from '../lib/og';
const ogImage = await ogImageFor('immo-hero');
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import JournalLink from '../components/sections/JournalLink.astro';
import SeoText from '../components/sections/SeoText.astro';
import ServiceTerms from '../components/sections/ServiceTerms.astro';
import Testimonial from '../components/sections/Testimonial.astro';
import { testimonialById } from '../data/testimonials';
import Gallery from '../components/media/Gallery.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import ProjectGrid from '../components/sections/ProjectGrid.astro';
import Cta from '../components/sections/Cta.astro';
import UseLine from '../components/sections/UseLine.astro';
import Faq from '../components/sections/Faq.astro';
import ServiceLinks from '../components/sections/ServiceLinks.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { getProjects } from '../lib/work';
import { serviceById } from '../data/services';
import { breadcrumbs, serviceSchema } from '../lib/schema';

const projects = await getProjects({ service: 'immobilien' });

const description =
  'Immobilienfotograf in Hamburg: Architektur-, Interior- und Drohnenaufnahmen für Exposés, Portale und Projektmarketing – natürliches Licht, gerade Linien.';
const schema = [
  serviceSchema(Astro.site, serviceById('immobilien'), 'Immobilienfotografie', description),
  breadcrumbs(Astro.site, [{ name: 'Immobilien & Interior', path: '/immobilienfotografie' }]),
];

const audiences = ['Makler', 'Projektentwickler', 'Architekturbüros', 'Interior Designer', 'Hotels', 'Gastronomie', 'Ferienimmobilien', 'Unternehmen'];
const principles = ['Natürliches Licht', 'Saubere Perspektiven', 'Realistische Farben', 'Sorgfältige Retusche', 'Atmosphäre erhalten'];
const uses = ['Exposés', 'Websites', 'Immobilienportale', 'Social Media', 'PR', 'Projektkommunikation', 'Hospitality Marketing'];

const faq = [
  {
    q: 'Wie bereiten wir die Räume vor?',
    a: 'Aufgeräumte Flächen, eingeschaltete Beleuchtung, persönliche Gegenstände aus dem Bild. Die wichtigsten Punkte für Ihr Objekt bespreche ich vorab mit Ihnen.',
  },
  {
    q: 'Arbeiten Sie mit HDR?',
    a: 'Nicht im Sinne der typischen, überzeichneten HDR-Optik. Wo es für Fenster und Innenraum nötig ist, kombiniere ich Belichtungen – und bearbeite so, dass Licht und Farben dem Raum entsprechen.',
  },
  {
    q: 'Fotografieren Sie Hotels und Restaurants im laufenden Betrieb?',
    a: 'Ja. Ich stimme die Zeitfenster so ab, dass Gäste möglichst wenig gestört werden – etwa vor Öffnung oder in ruhigen Stunden.',
  },
  {
    q: 'Welche Formate erhalten wir?',
    a: 'Quer- und Hochformate für Exposé, Website und Immobilienportale, innerhalb einer Woche nach dem Termin. Auf Wunsch zusätzlich zugeschnittene Formate für Social Media.',
  },
  {
    q: 'Fotografieren Sie auch unser Makler-Team?',
    a: 'Ja. Portraits und Teambilder für Website, Exposé und Portale entstehen in derselben Bildsprache wie die Objektfotos – an einem eigenen Termin oder, wenn es passt, am selben Tag.',
  },
  {
    q: 'Arbeiten Sie regelmäßig für uns, zum Beispiel bei jedem neuen Objekt?',
    a: 'Gerne. Bei wiederkehrendem Bedarf stimmen wir Ablauf und Vorlaufzeiten einmal ab, danach läuft jede Anfrage schneller.',
  },
  {
    q: 'Was kostet ein Immobilien-Shooting?',
    a: 'Das hängt von Umfang, Anzahl der Personen und Motive, Ort und geplanter Nutzung ab. Nach dem Briefing erhalten Sie ein verbindliches Angebot. Im Anfrageformular können Sie Ihren Budgetrahmen angeben – dann plane ich passend dazu.',
  },
  {
    q: 'Wie werden die Nutzungsrechte geregelt?',
    a: 'Nach dem geplanten Einsatz – Vermarktung, Portale, Presse. Wenn mehrere Beteiligte die Bilder nutzen möchten, etwa Bauherr und Architekturbüro, regle ich das vorab.',
  },
];
---

<BaseLayout ogImage={ogImage} title="Immobilien- & Architekturfotograf Hamburg" description={description} schema={schema}>
  <PageHeader
    kicker="Immobilien- & Architekturfotografie in Hamburg"
    clients
    label="Leistung 03"
    title="Immobilien & Interior"
    lead="Räume so, wie sie sich anfühlen – für Exposé, Immobilienportal, Hospitality Marketing und Projektkommunikation. Natürliches Licht, saubere Perspektiven, keine HDR-Optik."
    photo="immo-hero"
    photoMode="bleed"
    ratio="21 / 9"
  />

  <UseLine items={audiences} label="Für" class="section-y" />

  <Gallery layout="full" images={['immo-interior-1']} />
  <Gallery layout="pair" images={['immo-detail-1', 'immo-interior-2']} class="mt-[var(--gutter)]" />

  <section class="section-y">
    <div class="wrap grid-12 gap-y-8">
      <p class="label col-span-12 text-muted md:col-span-3 md:pt-[0.55em]" data-reveal>Ansatz</p>
      <div class="col-span-12 md:col-span-6" data-reveal>
        <p class="text-h3 !leading-[1.2]">Ich fotografiere mit dem Licht, das ein Raum hat, und ergänze nur dort, wo es nötig ist.</p>
        <p class="mt-6 max-w-[32rem] text-muted">
          Senkrechte Linien, ehrliche Farben, sorgfältig vorbereitete Räume. Die Bilder funktionieren im Exposé, auf der Website und
          im Hotelbuchungsportal – und halten auch beim Besichtigungstermin, was sie versprechen.
        </p>
      </div>
    </div>
  </section>

  <UseLine items={principles} label="Anspruch" class="-mt-[calc(var(--section)*0.5)] mb-[var(--section)]" />

  <Gallery layout="bleed" images={['immo-architecture']} />
  <Gallery layout="offset" images={['immo-hotel', 'immo-gastro']} class="mt-[var(--gutter)]" />
  <Gallery layout="single-r" images={['immo-detail-2']} class="mt-[var(--gutter)]" />

  <UseLine items={uses} label="Im Einsatz" class="section-t" />

  <SeoText label="Für Makler & Immobilienunternehmen" title="Ihr Team und Ihre Objekte – aus einer Hand" link={{ href: '/mitarbeiterfotos', text: 'Einheitliche Teamportraits' }}>
    <p>Für Maklerbüros, Bestandshalter und Projektentwickler fotografiere ich beides: <strong>die Menschen, die verkaufen, und die Objekte, die verkauft werden</strong>. Portraits für Teamseite und Exposé, dazu Architektur-, Interior- und Drohnenaufnahmen.</p>
    <p>So passt Ihr Auftritt auf Website, Portalen und Social Media zusammen – und lässt sich bei jedem neuen Objekt fortsetzen.</p>
  </SeoText>

  <Gallery
    layout="pair"
    class="mt-14 md:mt-20"
    images={[
      { id: 'weiss-team-schreibtisch', spec: { alt: 'Mitarbeiterin von Weiss Immobilien im Gespräch am Schreibtisch.', category: 'Team', format: 'Original', motif: 'Weiss Immobilien' } },
      { id: 'weiss-immobilien-wohnraum', spec: { alt: 'Wohnraum mit Blick über den Hamburger Hafen, fotografiert für Weiss Immobilien.', category: 'Objekt', format: 'Original', motif: 'Weiss Immobilien' } },
    ]}
  />

  <SeoText label="Architektur" title="Architektur- und Interiorfotografie in Hamburg">
    <p>Neben Wohnungen für die Vermarktung fotografiere ich Architektur und Interiors: Fassaden, Treppenhäuser, Foyers, Büro- und Gastronomieflächen. Mit geraden Linien, natürlichen Farben und Perspektiven, die den Raum ehrlich wiedergeben.</p>
    <p>Für Lage und Umgebung ergänzen <strong>Drohnenaufnahmen</strong> das Set. Die Tageszeit plane ich nach der Ausrichtung des Gebäudes, damit Fassade und Ausblick im besten Licht stehen.</p>
  </SeoText>

  {
    projects.length > 0 && (
      <section class="section-t">
        <SectionLabel label="Projekte" />
        <div class="wrap mt-10 mb-12 flex items-end justify-between gap-8 md:mt-14 md:mb-16">
          <h2 class="text-h2">Immobilien Projekte</h2>
          <ArrowLink href="/work" class="mb-[0.6em] hidden sm:inline-flex">Projekte ansehen</ArrowLink>
        </div>
        <ProjectGrid projects={projects} />
      </section>
    )
  }

  <Faq items={faq} />
  <ServiceLinks current="immobilien" />

  <Testimonial {...testimonialById('felix-weiss')} projectHref="/work/weiss-immobilien" class="section-t" />

  <ServiceTerms
    scope="Ein Objekt pro Termin oder mehrere Objekte als Serie – innen, außen und auf Wunsch aus der Luft."
    delivery="Innerhalb einer Woche nach dem Termin – in den Formaten für Exposé, Portale und Social Media."
  />

  <JournalLink slug="immobilienfotos-vorbereiten" />

  <Cta
    title="Objekt in Vorbereitung?"
    text="Schicken Sie mir Adresse, Größe und gewünschten Termin. Ich melde mich mit Angebot und Hinweisen zur Vorbereitung der Räume."
  />
</BaseLayout>
