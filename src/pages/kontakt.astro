---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import { site } from '../config/site';

const addressLine = [site.address.street, [site.address.zip, site.address.city].filter(Boolean).join(' ')].filter(Boolean);
---

<BaseLayout
  title="Projekt anfragen – Hamburg"
  description="Erzählen Sie kurz, was Sie vorhaben – Sie erhalten eine persönliche Rückmeldung mit Einschätzung und Vorschlag. Marcel Kuhls, Unternehmensfotograf in Hamburg."
>
  <section class="section-y pt-14 md:pt-24">
    <div class="wrap grid-12 gap-y-10">
      <p class="label col-span-12 text-muted md:col-span-3 md:pt-[0.9em]">Kontakt</p>
      <h1 class="col-span-12 text-display md:col-span-9">Lassen Sie uns über Ihr Projekt sprechen.</h1>
    </div>

    <div class="wrap grid-12 mt-16 gap-y-16 md:mt-28">
      <aside class="col-span-12 space-y-10 md:col-span-3">
        <div>
          <p class="label mb-3 text-muted">So geht es weiter</p>
          <ol class="space-y-3 text-[0.9375rem]">
            <li><span class="text-muted tabular-nums">1</span>&ensp;Sie schreiben kurz, worum es geht.</li>
            <li><span class="text-muted tabular-nums">2</span>&ensp;Ich melde mich persönlich mit Rückfragen oder einem Vorschlag.</li>
            <li><span class="text-muted tabular-nums">3</span>&ensp;Sie erhalten ein schriftliches Angebot.</li>
          </ol>
        </div>
        {site.phone && (
          <div>
            <p class="label mb-3 text-muted">Lieber telefonieren?</p>
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="link-line font-display text-[1.375rem] tracking-[-0.01em]">{site.phone}</a>
          </div>
        )}
        <div>
          <p class="label mb-3 text-muted">E-Mail</p>
          <a href={`mailto:${site.email}`} class="link-line block break-all">{site.email}</a>
        </div>
        <div>
          <p class="label mb-3 text-muted">Adresse</p>
          <p>{site.name}<br />{addressLine.map((l) => <>{l}<br /></>)}</p>
        </div>
        <div>
          <p class="label mb-3 text-muted">Ansprechpartner</p>
          <p class="text-muted">Marcel Kuhls, Gründer und Fotograf</p>
        </div>
      </aside>

      <div class="col-span-12 md:col-span-8 md:col-start-5 lg:col-span-7 lg:col-start-5">
        <p class="mb-14 max-w-[32rem] text-lead">
          Erzählen Sie kurz, was Sie vorhaben. Sie erhalten eine persönliche Rückmeldung mit einer ersten Einschätzung.
        </p>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
