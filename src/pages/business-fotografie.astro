---
import { ogImageFor } from '../lib/og';
const ogImage = await ogImageFor('business-hero');
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import JournalLink from '../components/sections/JournalLink.astro';
import SeoText from '../components/sections/SeoText.astro';
import ServiceTerms from '../components/sections/ServiceTerms.astro';
import Testimonial from '../components/sections/Testimonial.astro';
import { testimonialById } from '../data/testimonials';
import Faq from '../components/sections/Faq.astro';
import Statement from '../components/sections/Statement.astro';
import Gallery from '../components/media/Gallery.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import IndexList from '../components/sections/IndexList.astro';
import ProjectGrid from '../components/sections/ProjectGrid.astro';
import Process from '../components/sections/Process.astro';
import Cta from '../components/sections/Cta.astro';
import UseLine from '../components/sections/UseLine.astro';
import ServiceLinks from '../components/sections/ServiceLinks.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { getProjects } from '../lib/work';
import { serviceById } from '../data/services';
import { breadcrumbs, serviceSchema } from '../lib/schema';

const projects = await getProjects({ service: 'business' });

const faq = [
  {
    q: 'Kommen Sie zu uns ins Unternehmen?',
    a: 'Ja. Ich fotografiere in Ihren Räumen, mit einem mobilen Studio-Setup für einheitliche Portraits oder direkt in Ihrer Arbeitsumgebung. Sie brauchen dafür nur einen ruhigen Raum oder eine passende Ecke.',
  },
  {
    q: 'Wie lange dauert ein Portrait pro Person?',
    a: 'Für ein Portrait mit mehreren Varianten reichen meist wenige Minuten. Bei Teams plane ich feste Zeitfenster, damit niemand lange aus dem Arbeitstag herausgeholt wird.',
  },
  {
    q: 'Können neue Mitarbeitende später im gleichen Look fotografiert werden?',
    a: 'Ja. Licht, Hintergrund, Ausschnitt und Bearbeitung halte ich fest. So lassen sich neue Kolleginnen und Kollegen auch Monate später im gleichen Look in die bestehende Teamseite einfügen.',
  },
  {
    q: 'Was sollen wir anziehen?',
    a: 'Das, was Sie auch im Arbeitsalltag tragen, gepflegt und am besten einfarbig. Ein, zwei Alternativen, etwa mit und ohne Sakko, geben mehr Möglichkeiten für unterschiedliche Einsätze.',
  },
  {
    q: 'Was kostet ein Business-Shooting?',
    a: 'Das hängt von der Anzahl der Personen, den Motiven, dem Ort und der geplanten Nutzung ab. Nach dem Briefing erhalten Sie ein verbindliches Angebot. Im Anfrageformular können Sie Ihren Budgetrahmen angeben.',
  },
  {
    q: 'Wann erhalten wir die Bilder?',
    a: 'Innerhalb einer Woche nach dem Shooting. Die Bilder sind bearbeitet, hochaufgelöst für Druck und optimiert für Web und LinkedIn.',
  },
];

const description =
  'Business- und Corporate-Fotografie in Hamburg: Portraits, Führungsteams und Arbeitswelten mit einheitlicher Bildsprache. Für Website, Presse, LinkedIn und Geschäftsbericht.';
const schema = [
  serviceSchema(Astro.site, serviceById('business'), 'Business- und Corporate-Fotografie', description),
  breadcrumbs(Astro.site, [{ name: 'Business & Corporate', path: '/business-fotografie' }]),
];

const offers = [
  { title: 'Portraits', text: 'Geschäftsführung, Vorstand, Mitarbeitende. Im Studio-Setup vor Ort oder in Ihrer Arbeitsumgebung.' },
  { title: 'Führungsteams', text: 'Gruppenbilder mit Haltung, für Website, Geschäftsbericht und Presse.' },
  { title: 'Arbeitswelten', text: 'Büros, Produktion, Kundenkontakt. Reportageartige Bilder für Website und Kommunikation.' },
  { title: 'Presse & PR', text: 'Bildmaterial zu Personalien, Standorten und Anlässen, passend zum restlichen Auftritt.' },
];
---

<BaseLayout ogImage={ogImage} title="Businessfotograf & Corporate-Fotograf Hamburg" description={description} schema={schema}>
  <PageHeader
    kicker="Businessfotograf & Corporate-Fotograf in Hamburg"
    clients="business"
    label="Leistung 02"
    title="Business & Corporate"
    lead="Portraits und Unternehmensbilder mit einer Bildsprache, die zu Ihrer Marke passt. Sie bleibt einheitlich über alle Personen, Standorte und Termine hinweg."
    photo="business-hero"
  />

  <Statement label="Anspruch" class="section-y">
    Ein gutes Business-Portrait wirkt souverän, ohne steif zu sein. Ich nehme mir Zeit für jede Person, führe klar durch den
    Termin und sorge dafür, dass auch der zwanzigste Mitarbeitende im selben Licht steht wie der erste.
  </Statement>

  <Gallery layout="pair" images={['business-portrait-1', 'business-portrait-2']} />
  <Gallery layout="offset-r" images={['business-team', 'business-portrait-3']} class="mt-[var(--gutter)]" />

  <section class="section-t">
    <SectionLabel label="Leistungen" />
    <div class="wrap mt-10 md:mt-14">
      <IndexList items={offers} />
    </div>
    <UseLine
      items={['Website', 'LinkedIn', 'Presse', 'Geschäftsbericht', 'Präsentationen', 'Unternehmenskommunikation']}
      class="mt-14 md:mt-20"
    />
  </section>

  <SeoText label="Corporate-Fotografie" title="Businessfotografie und Corporate-Fotografie in Hamburg">
    <p>Als <strong>Businessfotograf und Corporate-Fotograf in Hamburg</strong> fotografiere ich Geschäftsführung, Führungsteams und Arbeitswelten für Website, Presse, LinkedIn und Geschäftsbericht. Fotografiert wird bei Ihnen im Unternehmen, im Büro oder vor Ort beim Kunden.</p>
    <p>Gute Businessfotografie und Corporate-Fotografie heißen für mich: ein einheitlicher Look über alle Personen, Standorte und Termine hinweg. So passen Pressefoto, Teamseite und Präsentation zusammen.</p>
  </SeoText>

  <SeoText label="Mitarbeiterfotos" title="Mitarbeiterfotos und Teamfotos in Hamburg" link={{ href: '/mitarbeiterfotos', text: 'Mitarbeiterfotos im Detail' }}>
    <p>Als Businessfotograf in Hamburg fotografiere ich Geschäftsführung, Teams und Mitarbeitende direkt bei Ihnen vor Ort, mit einem mobilen Studio-Setup oder in Ihrer Arbeitsumgebung.</p>
    <p>Alle Portraits entstehen in <strong>einem einheitlichen Look</strong>: gleiches Licht, gleicher Ausschnitt, gleiche Bearbeitung. So wirkt Ihre Teamseite geschlossen, und neue Kolleginnen und Kollegen lassen sich später im selben Stil ergänzen.</p>
  </SeoText>

  <Gallery layout="bleed" images={['business-workspace']} class="section-t" />

  {
    projects.length > 0 && (
      <section class="section-t">
        <SectionLabel label="Projekte" />
        <div class="wrap mt-10 mb-12 flex items-end justify-between gap-8 md:mt-14 md:mb-16">
          <h2 class="text-h2">Business Projekte</h2>
          <ArrowLink href="/work" class="mb-[0.6em] hidden sm:inline-flex">Projekte ansehen</ArrowLink>
        </div>
        <ProjectGrid projects={projects} />
      </section>
    )
  }

  <Process />
  <Testimonial {...testimonialById('konstantin-tuludis')} class="section-t" />

  <ServiceTerms
    scope="Vom einzelnen Portrait bis zum ganzen Team an mehreren Standorten. Den Zeitplan pro Person stimme ich vorab mit Ihnen ab."
    delivery="Innerhalb einer Woche nach dem Shooting, bearbeitet und für Web und Druck aufbereitet."
  />

  <Faq items={faq} />
  <ServiceLinks current="business" />
  <JournalLink slug="business-portraits-vorbereitung" />

  <Cta />
</BaseLayout>
