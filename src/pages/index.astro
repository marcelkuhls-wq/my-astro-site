---
import { ogImageFor } from '../lib/og';
const ogImage = await ogImageFor('home-hero');
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/media/Photo.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Statement from '../components/sections/Statement.astro';
import UseLine from '../components/sections/UseLine.astro';
import ServiceFeature from '../components/sections/ServiceFeature.astro';
import ProjectGrid from '../components/sections/ProjectGrid.astro';
import IndexList from '../components/sections/IndexList.astro';
import Process from '../components/sections/Process.astro';
import Reviews from '../components/sections/Reviews.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import ClientLine from '../components/sections/ClientLine.astro';
import Cta from '../components/sections/Cta.astro';
import { serviceById, allUses } from '../data/services';
import { getProjects } from '../lib/work';

const featured = await getProjects({ featured: true });
const allProjects = await getProjects();
---

<BaseLayout ogImage={ogImage}
  title="Unternehmensfotograf in Hamburg – Marcel Kuhls"
  description="Unternehmensfotograf Marcel Kuhls, Hamburg: Employer Branding, Business-Portraits, Immobilien und Events – Bilder für Website, Recruiting und Presse."
>
  {/* HERO: Headline, ein Satz, ein CTA ------------------------------------ */}
  <section class="flex flex-col pt-6 md:pt-10">
    <div class="wrap grid-12 items-end gap-y-7">
      <h1 class="hero-lines col-span-12 text-display md:col-span-9">
        <span class="label mb-5 block !tracking-[0.1em] text-muted md:mb-7">Unternehmensfotograf in Hamburg</span>
        <span class="line"><span>Menschen. Räume.</span></span>{' '}
        <span class="line"><span style="--i: 1">Unternehmen.</span></span>
      </h1>
      <div class="hero-fade col-span-12 md:col-span-3 md:pb-[0.4rem]">
        <p class="max-w-[22rem]">
          Ihr Team, Ihre Räume, Ihre Veranstaltungen – fotografiert aus einer Hand, in einer Bildsprache.
        </p>
        <ArrowLink href="/kontakt" class="mt-7">Projekt anfragen</ArrowLink>
      </div>
    </div>
    {/* Bild füllt den Rest des ersten Bildschirms und ragt leicht darüber hinaus */}
    <div class="wrap relative mt-8 h-[68svh] md:mt-10 md:h-[max(34rem,calc(100svh-var(--header-h)-13rem))]">
      <Photo id="home-hero" ratio="auto" sizes="(min-width: 768px) 94vw, 100vw" priority crop class="hero-curtain !absolute inset-y-0 inset-x-[var(--margin)]" />
    </div>
  </section>

  <ClientLine class="mt-10 md:mt-14" />

  {/* INTRO + WOFÜR ------------------------------------------------------- */}
  <Statement label="Studio Kuhls" class="section-t">
    Hinter Studio Kuhls stehe ich, Marcel Kuhls – Unternehmensfotograf in Hamburg. Ich fotografiere Team, Arbeitsalltag, Räume und
    Veranstaltungen eines Unternehmens in einem Look, der sich über Jahre fortsetzen lässt. Ein Fotograf, ein Ansprechpartner, eine Bildsprache.
    <Fragment slot="aside">
      <div class="col-span-12 lg:col-span-7">
        <p class="label mb-3 text-muted">Für</p>
        <p class="text-muted">
          HR- und People-Teams, Marketing und Unternehmenskommunikation, Agenturen, Makler und Projektentwickler, Hotels und
          Gastronomie.
        </p>
      </div>
    </Fragment>
  </Statement>

  <UseLine items={allUses} class="mt-16 mb-[var(--section)] md:mt-24" />

  {/* LEISTUNGEN ---------------------------------------------------------- */}
  <SectionLabel label="Leistungen" number="01–04" />

  <ServiceFeature
    first
    service={serviceById('employer-branding')}
    variant="wide"
    photos={['home-eb']}
    text="Ihre Teams bei der Arbeit – geplant mit HR, fotografiert im laufenden Betrieb, in einer Bildsprache für Karriereseite, Anzeigen und LinkedIn."
  />
  <ServiceFeature
    service={serviceById('business')}
    variant="pair"
    photos={['home-business-1', 'home-business-2']}
    text="Portraits von Geschäftsführung und Mitarbeitenden, Führungsteams und Arbeitswelten – einheitlich im Look über alle Personen und Termine."
  />
  <ServiceFeature
    service={serviceById('immobilien')}
    variant="bleed"
    photos={['home-immobilien']}
    text="Architektur und Interior für Makler, Projektentwickler, Architekturbüros, Hotels und Gastronomie. Natürliches Licht, saubere Linien, keine HDR-Optik."
  />
  <ServiceFeature
    service={serviceById('events')}
    variant="scatter"
    photos={['home-events-1', 'home-events-2', 'home-events-3']}
    text="Konferenzen, Produktlaunches, Dinner und Eröffnungen – dokumentarisch fotografiert: Menschen, Atmosphäre, Speaker und Details."
  />

  {/* SELECTED WORK ------------------------------------------------------- */}
  {
    featured.length > 0 && (
      <section class="section-t">
        <SectionLabel label="Ausgewählte Arbeiten" />
        <div class="wrap mt-10 mb-12 flex items-end justify-between gap-8 md:mt-14 md:mb-16">
          <h2 class="text-h2">Projekte</h2>
          <ArrowLink href="/work" class="mb-[0.6em]">Alle {allProjects.length} Projekte</ArrowLink>
        </div>
        <ProjectGrid projects={featured} layout="compact" />
      </section>
    )
  }

  <Reviews ids={['felix-weiss', 'konstantin-tuludis', 'felix-lippe', 'till', 'rabil-smith']} />

  {/* EMPLOYER BRANDING FEATURE ------------------------------------------- */}
  <section class="section-y mt-[var(--section)] bg-ink text-bone">
    <SectionLabel label="Schwerpunkt Employer Branding" dark />
    <div class="wrap grid-12 mt-10 gap-y-8 md:mt-14">
      <h2 class="col-span-12 text-h2 md:col-span-8" data-reveal>Menschen bewerben sich bei Menschen.</h2>
      <p class="col-span-12 max-w-[34rem] text-lead text-bone/80 md:col-span-6 md:col-start-4" data-reveal style="--reveal-delay: .08s">
        Eine Karriereseite mit Stockfotos sagt nichts über Ihr Unternehmen. Echte Bilder Ihrer Teams zeigen Kultur, Arbeitsumgebung
        und Zusammenarbeit – bevor das erste Gespräch stattfindet.
      </p>
    </div>

    <div class="wrap grid-12 mt-12 items-start gap-y-[var(--gutter)] md:mt-16">
      <Photo id="home-eb-feature-1" ratio="4 / 5" sizes="(min-width: 768px) 31vw, 50vw" class="col-span-6 md:col-span-4 md:col-start-2" />
      <Photo
        id="home-eb-feature-2"
        ratio="3 / 2"
        sizes="(min-width: 768px) 47vw, 100vw"
        class="col-span-6 mt-[30%] md:col-span-6 md:col-start-7 md:mt-[12%]"
      />
    </div>

    <div class="wrap mt-12 md:mt-16">
      <IndexList
        dark
        items={[
          { title: 'Recruiting', text: 'Bilder für Stellenanzeigen und Kampagnen, die zur Rolle passen – vom Ausbildungsplatz bis zur Führungsebene.' },
          { title: 'Karriereseite', text: 'Arbeitsplätze, Teams und Alltag als zusammenhängende Bildwelt statt einzelner Motive.' },
          { title: 'LinkedIn & Social Media', text: 'Laufend nutzbares Material, auch im Hochformat für Posts und Stories.' },
          { title: 'Unternehmens­kommunikation', text: 'Für Website, Geschäftsbericht, Presse und interne Kanäle.' },
        ]}
      />
      <ArrowLink href="/employer-branding" context="über Employer Branding" class="mt-12">Mehr erfahren</ArrowLink>
    </div>
  </section>

  {/* VORBEREITUNG & ABLAUF ----------------------------------------------- */}
  <Process />


  {/* ABOUT --------------------------------------------------------------- */}
  <section class="section-y">
    <div class="wrap grid-12 items-end gap-y-10">
      <Photo id="home-about" ratio="4 / 5" sizes="(min-width: 768px) 31vw, 100vw" class="col-span-12 sm:col-span-8 md:col-span-4" />
      <div class="col-span-12 md:col-span-6 md:col-start-6 lg:col-span-5 lg:col-start-7" data-reveal>
        <p class="label text-muted">Der Fotograf</p>
        <h2 class="mt-5 text-h2">Marcel Kuhls</h2>
        <p class="mt-8 text-lead">
          Fotograf und Gründer von Studio Kuhls. Seit über zehn Jahren fotografiert er Menschen, Räume und Veranstaltungen.
        </p>
        <p class="mt-5 max-w-[32rem] text-muted">
          Jedes Projekt leitet er persönlich – vom ersten Gespräch über den Produktionstag bis zur finalen Bildauswahl. Sie haben
          einen Ansprechpartner, der Ihr Unternehmen kennt.
        </p>
        <ArrowLink href="/about" context="über Studio Kuhls" class="mt-10">Mehr erfahren</ArrowLink>
      </div>
    </div>
  </section>

  <ClientLogos />
  <Cta />
</BaseLayout>
