---
/**
 * Eine Leistung auf der Startseite. Jede Variante hat eine eigene
 * Komposition, damit die vier Bereiche nicht wie identische Karten wirken.
 *
 *  wide     großes Querformat links, Text rechts unten
 *  pair     Text links oben, zwei Hochformate versetzt rechts
 *  bleed    randloses Panorama, Text zweispaltig darunter
 *  scatter  drei Bilder in wechselnden Größen (Events – lebendiger)
 */
import Photo from '../media/Photo.astro';
import ServiceText from './ServiceText.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
  variant: 'wide' | 'pair' | 'bleed' | 'scatter';
  photos: string[];
  text: string;
  /** Erster Block direkt unter dem Abschnittslabel – weniger Abstand */
  first?: boolean;
}
const { service, variant, photos, text, first = false } = Astro.props;
const [a, b, c] = photos;
const textProps = { service, text };
---

<section class:list={[first ? 'mt-10 md:mt-14' : 'section-t']} aria-labelledby={`svc-${service.id}`}>
  {
    variant === 'wide' && (
      <div class="wrap grid-12 items-end gap-y-8">
        <Photo id={a} ratio="3 / 2" sizes="(min-width: 768px) 62vw, 100vw" class="col-span-12 md:col-span-8" />
        <div class="col-span-12 md:col-span-4 md:pl-[8%]" data-reveal>
          <ServiceText {...textProps} />
        </div>
      </div>
    )
  }

  {
    variant === 'pair' && (
      <div class="wrap grid-12 items-start gap-y-8">
        <div class="col-span-12 md:col-span-4 md:pr-[8%]" data-reveal>
          <ServiceText {...textProps} />
        </div>
        <Photo id={a} ratio="4 / 5" sizes="(min-width: 768px) 31vw, 100vw" class="col-span-12 md:col-span-4" />
        <Photo
          id={b}
          ratio="4 / 5"
          sizes="(min-width: 768px) 31vw, 60vw"
          class="col-span-8 col-start-5 md:col-span-4 md:col-start-auto md:mt-[36%]"
        />
      </div>
    )
  }

  {
    variant === 'bleed' && (
      <>
        <Photo id={a} ratio="21 / 9" sizes="100vw" drift class="max-md:!aspect-[4/3]" />
        <div class="wrap grid-12 mt-8 gap-y-6 md:mt-10" data-reveal>
          <div class="col-span-12 md:col-span-6">
            <ServiceText {...textProps} part="heading" />
          </div>
          <div class="col-span-12 md:col-span-5 md:col-start-8 md:pt-[2.1rem]">
            <ServiceText {...textProps} part="copy" />
          </div>
        </div>
      </>
    )
  }

  {
    variant === 'scatter' && (
      <div class="wrap grid-12 items-start gap-y-8">
        <div class="col-span-12 md:col-span-4 md:pr-[8%]" data-reveal>
          <ServiceText {...textProps} />
        </div>
        <Photo id={a} ratio="3 / 2" sizes="(min-width: 768px) 55vw, 100vw" class="col-span-12 md:col-span-7 md:col-start-6" />
        <Photo
          id={b}
          ratio="4 / 5"
          sizes="(min-width: 768px) 31vw, 60vw"
          class="col-span-7 md:col-span-4 md:col-start-2 md:mt-[-6%]"
        />
        <Photo
          id={c}
          ratio="1 / 1"
          sizes="(min-width: 768px) 23vw, 45vw"
          class="col-span-5 mt-[40%] md:col-span-3 md:col-start-8 md:mt-[14%]"
        />
      </div>
    )
  }
</section>
