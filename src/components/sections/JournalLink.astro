---
/** Verweis von einer Leistungsseite auf den passenden Journal-Artikel */
import { getEntry } from 'astro:content';
import SectionLabel from '../ui/SectionLabel.astro';
import IndexList from './IndexList.astro';

interface Props {
  slug: string;
}
const entry = await getEntry('journal', Astro.props.slug);
const show = entry && !entry.data.draft;
---

{
  show && (
    <section class="section-t">
      <SectionLabel label="Aus dem Journal" />
      <div class="wrap mt-10 md:mt-14">
        <IndexList numbered={false} items={[{ title: entry.data.title, text: entry.data.description, href: `/journal/${entry.id}` }]} />
      </div>
    </section>
  )
}
