---
/**
 * Vorbereitung + Ablauf einer Produktion. Vier Textspalten an einer Linie,
 * keine Kacheln, keine Icons. Die Einleitung zeigt, dass vor dem Shooting
 * mitgedacht wird (Konzept, Motive, Location, Licht, Personen, Formate).
 */
import SectionLabel from '../ui/SectionLabel.astro';
import UseLine from './UseLine.astro';

interface Step {
  title: string;
  text: string;
}
interface Props {
  steps?: Step[];
  label?: string;
  title?: string;
  intro?: string;
  /** Was vorab geklärt wird – als typografische Zeile */
  planning?: string[] | false;
}

const defaultSteps: Step[] = [
  {
    title: 'Briefing',
    text: 'Ziel, Einsatz der Bilder, Bildsprache und benötigte Motive. Danach erhalten Sie ein klares Angebot.',
  },
  {
    title: 'Planung',
    text: 'Locations, beteiligte Personen, Zeitfenster und Motivliste werden vorab mit Ihnen abgestimmt.',
  },
  {
    title: 'Produktion',
    text: 'Ruhig und effizient – mit so wenig Eingriff in Ihren Arbeitsalltag wie möglich.',
  },
  {
    title: 'Postproduktion',
    text: 'Auswahl, sorgfältige Bearbeitung und Übergabe in den Formaten, die Sie brauchen: Web, Social Media, Druck.',
  },
];

const {
  steps = defaultSteps,
  label = 'Ablauf',
  title = 'Die Arbeit beginnt vor dem ersten Bild.',
  intro = 'Bevor wir fotografieren, klären wir, wo die Bilder eingesetzt werden und was sie leisten sollen. Daraus entstehen Motivliste, Ablaufplan und Bildsprache – damit der Produktionstag ruhig und planbar verläuft.',
  planning = ['Bildkonzept', 'Motive', 'Locations', 'Licht', 'Personen', 'Formate'],
} = Astro.props;
---

<section class="section-t">
  <SectionLabel label={label} />
  <div class="wrap grid-12 mt-10 gap-y-8 md:mt-14">
    <h2 class="col-span-12 text-h2 md:col-span-8" data-reveal>{title}</h2>
    {
      intro && (
        <p class="col-span-12 max-w-[34rem] text-muted md:col-span-6 md:col-start-4" data-reveal style="--reveal-delay: .06s">
          {intro}
        </p>
      )
    }
  </div>

  {planning && <UseLine items={planning} label="Vorab geklärt" size="body" class="mt-10 md:mt-12" />}

  <div class="wrap">
    <ol class="grid-12 mt-14 gap-y-10 md:mt-20">
      {
        steps.map((step, i) => (
          <li class="relative col-span-12 pt-5 sm:col-span-6 lg:col-span-3">
            <span class="absolute inset-x-0 top-0 h-px bg-ink" data-reveal="line" style={`--reveal-delay: ${i * 0.12}s`} aria-hidden="true" />
            <div data-reveal style={`--reveal-delay: ${0.2 + i * 0.12}s`}>
            <p class="label tabular-nums text-muted">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-6 text-[1.375rem] leading-tight tracking-[-0.015em]">{step.title}</h3>
            <p class="mt-3 max-w-[30ch] text-muted">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
