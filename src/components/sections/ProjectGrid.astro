---
/**
 * Editoriales Projektraster. Die Positionen folgen einem festen 5er-Rhythmus:
 * groß quer · quer + hoch versetzt · hoch + quer versetzt – dann von vorn.
 * So entstehen wechselnde Bildgrößen ohne Masonry und ohne Lücken auf Mobile.
 */
import type { ImageMetadata } from 'astro';
import ProjectCard from './ProjectCard.astro';
import { photos } from '../../data/photos';
import type { Project } from '../../lib/work';

interface Props {
  projects: Project[];
  /** Beim ersten Bild die Priorität setzen (z. B. /work) */
  priorityFirst?: boolean;
  /** "pair" = zwei gleich große Querformate, z. B. für "Weitere Projekte" */
  /** "compact" = 1 breit + 3 nebeneinander (Startseite) */
  /** "grid" = Masonry mit zwei Formaten (Projektübersicht) */
  layout?: 'editorial' | 'pair' | 'compact' | 'grid';
  /** Ein Satz Kontext unter jedem Projekt: wofür die Bilder entstanden sind */
  showContext?: boolean;
}
const { projects, priorityFirst = false, layout = 'editorial', showContext = true } = Astro.props;

const pairSlot = { cls: 'col-span-12 md:col-span-6', ratio: '3 / 2', sizes: '(min-width: 768px) 47vw, 100vw' };
const editorialSlots = [
  { cls: 'col-span-12', ratio: '16 / 9', sizes: '(min-width: 768px) 94vw, 100vw' },
  { cls: 'col-span-12 md:col-span-7', ratio: '3 / 2', sizes: '(min-width: 768px) 55vw, 100vw' },
  { cls: 'col-span-12 md:col-span-4 md:col-start-9 md:mt-[14%]', ratio: '4 / 5', sizes: '(min-width: 768px) 31vw, 100vw' },
  { cls: 'col-span-12 md:col-span-5 md:col-start-2', ratio: '4 / 5', sizes: '(min-width: 768px) 39vw, 100vw' },
  { cls: 'col-span-12 md:col-span-6 md:col-start-7 md:mt-[16%]', ratio: '3 / 2', sizes: '(min-width: 768px) 47vw, 100vw' },
];
const compactSlots = [
  { cls: 'col-span-12', ratio: '21 / 9', sizes: '(min-width: 768px) 94vw, 100vw' },
  { cls: 'col-span-12 md:col-span-4', ratio: '4 / 5', sizes: '(min-width: 768px) 31vw, 100vw' },
  { cls: 'col-span-12 md:col-span-4', ratio: '4 / 5', sizes: '(min-width: 768px) 31vw, 100vw' },
  { cls: 'col-span-12 md:col-span-4', ratio: '4 / 5', sizes: '(min-width: 768px) 31vw, 100vw' },
];
const slots = layout === 'pair' ? [pairSlot] : layout === 'compact' ? compactSlots : editorialSlots;
// "compact": nur das erste Projekt breit, danach alle in Dreierreihen
const slotFor = (i: number) => (layout === 'compact' ? (i === 0 ? compactSlots[0] : compactSlots[1]) : slots[i % slots.length]);

// Hochformat-Titelbilder gehören in Hochformat-Plätze (sonst viel Leerraum daneben):
// Im Raster rückt jeweils das nächste passende Projekt nach (max. 3 Plätze vorgezogen).
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const dims = new Map(Object.entries(files).map(([path, m]) => [path.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]));
const isPortrait = (p: Project) => {
  const img = dims.get(p.data.cover.id) ?? dims.get(photos[p.data.cover.id]?.file ?? '');
  return img ? img.height > img.width : false;
};
const ratioOf = (p: Project) => {
  const img = dims.get(p.data.cover.id) ?? dims.get(photos[p.data.cover.id]?.file ?? '');
  return img ? img.width / img.height : 1.5;
};
const slotPortrait = (i: number) => {
  const [w, h] = slotFor(i).ratio.split('/').map(Number);
  return h > w;
};
// Masonry-Verteilung: Bildhöhe je Format, plus Platz für die Bildunterschrift
const masonry = (n: number) => {
  const cols = Array.from({ length: n }, () => ({ h: 0, items: [] as { p: Project; i: number }[] }));
  projects.forEach((p, i) => {
    const c = cols.reduce((a, b) => (b.h < a.h - 0.01 ? b : a));
    c.items.push({ p, i });
    c.h += (isPortrait(p) ? 1.25 : 2 / 3) + 0.3;
  });
  return cols.map((c) => c.items);
};
const ordered: Project[] = [];
if (layout === 'compact' || layout === 'grid') ordered.push(...projects);
else {
  const queue = [...projects];
  for (let i = 0; queue.length; i++) {
    const want = slotPortrait(i);
    const j = queue.slice(0, 4).findIndex((p) => isPortrait(p) === want);
    ordered.push(...queue.splice(j === -1 ? 0 : j, 1));
  }
}
---

{
  layout === 'grid' ? (
    <>
      {/* Masonry: gleich breite Spalten, nur zwei Formate (quer 3:2, hoch 4:5); jedes Projekt kommt in die
          jeweils kürzeste Spalte, so enden alle Spalten etwa gleich. */}
      {[
        { n: 3, cls: 'hidden md:flex', sizes: '(min-width: 768px) 31vw, 100vw', main: true },
        { n: 2, cls: 'flex md:hidden', sizes: '50vw', main: false },
      ].map((v) => (
        <div class:list={['wrap items-start gap-x-[var(--gutter)]', v.cls]}>
          {masonry(v.n).map((col) => (
            <div class="flex min-w-0 flex-1 flex-col gap-y-10 md:gap-y-14">
              {col.map(({ p, i }) => (
                <ProjectCard project={p} ratio={isPortrait(p) ? '4 / 5' : '3 / 2'} crop sizes={v.sizes} showContext={showContext} priority={v.main && priorityFirst && i === 0} transition={v.main} />
              ))}
            </div>
          ))}
        </div>
      ))}
    </>
  ) : (
    <div class="wrap grid-12 items-start gap-y-12 md:gap-y-20">
      {ordered.map((p, i) => {
        const slot = slotFor(i);
        // Passt das Format trotzdem nicht (Hochformat im Querformat-Platz), wird beschnitten
        const crop = isPortrait(p) && !slotPortrait(i);
        return <ProjectCard class={slot.cls} project={p} ratio={slot.ratio} sizes={slot.sizes} crop={crop} showContext={showContext} priority={priorityFirst && i === 0} />;
      })}
    </div>
  )
}
