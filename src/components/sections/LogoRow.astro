---
/**
 * Kundenlogos als ruhiges Laufband: läuft von rechts nach links, blendet an den
 * Rändern weich aus, das überfahrene Logo tritt hervor. Bei „weniger Bewegung“ statisch.
 */
import { logos } from '../../data/clients';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<section class:list={['logo-band border-y border-line py-10 md:py-14', className]} aria-label="Kunden">
  <p class="label wrap text-center text-muted" data-reveal>Projekte u. a. für</p>
  <div class="logo-marquee mt-8 md:mt-10">
    <div class="logo-track">
      {
        [0, 1].map((copy) => (
          <ul class="logo-set" aria-label={copy === 0 ? 'Kundenlogos' : undefined} aria-hidden={copy === 1 ? 'true' : undefined}>
            {logos.map((l) => (
              <li>
                <img
                  src={`/logos/${l.file}`}
                  alt={copy === 0 ? l.name : ''}
                  title={l.name}
                  loading="lazy"
                  decoding="async"
                  width={l.w}
                  height={l.h}
                  style={`--s: ${l.scale ?? 1}`}
                />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Weiche Ränder als Verlauf-Overlays statt mask-image –
     Safari aktualisiert animierte Inhalte unter einer Maske teils nicht. */
  .logo-marquee {
    position: relative;
    overflow: hidden;
  }
  .logo-marquee::before,
  .logo-marquee::after {
    content: '';
    position: absolute;
    inset-block: 0;
    z-index: 1;
    width: 15%;
    pointer-events: none;
  }
  .logo-marquee::before {
    left: 0;
    background: linear-gradient(to right, var(--color-paper), transparent);
  }
  .logo-marquee::after {
    right: 0;
    background: linear-gradient(to left, var(--color-paper), transparent);
  }
  .logo-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: logo-scroll 45s linear infinite;
  }
  .logo-set {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding-right: 3.5rem;
    margin: 0;
    list-style: none;
  }
  .logo-set img {
    display: block;
    width: auto;
    height: calc(1.4rem * var(--s));
    opacity: 0.75;
    transition:
      opacity 0.4s,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Spotlight: das überfahrene Logo tritt hervor, die anderen zurück */
  .logo-marquee:hover .logo-set img {
    opacity: 0.25;
  }
  .logo-marquee .logo-set img:hover {
    opacity: 1;
    transform: scale(1.08);
  }
  @media (min-width: 768px) {
    .logo-set {
      gap: 5.5rem;
      padding-right: 5.5rem;
    }
    .logo-set img {
      height: calc(1.9rem * var(--s));
    }
  }
  @keyframes logo-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track {
      animation: none;
      width: auto;
      justify-content: center;
    }
    .logo-set {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1.5rem;
      padding-inline: var(--gutter);
    }
    .logo-set[aria-hidden='true'] {
      display: none;
    }
    .logo-marquee::before,
    .logo-marquee::after {
      display: none;
    }
  }
</style>
