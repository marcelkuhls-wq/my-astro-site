---
/** Abschluss jeder Seite: eine Frage, ein Satz, ein Weg zum Kontakt. */
import { site } from '../../config/site';

interface Props {
  title?: string;
  text?: string;
  /** Ziel des Anfrage-Links, z. B. mit vorausgewählter Projektart */
  href?: string;
}
const {
  href = '/kontakt',
  title = 'Was steht an?',
  text = 'Ein paar Sätze zu Projekt, Zeitraum und Ort reichen für den Anfang. Ich melde mich mit einer ersten Einschätzung und einem Vorschlag für das weitere Vorgehen.',
} = Astro.props;
---

<section class="section-y">
  <div class="wrap grid-12 gap-y-10 border-t border-ink pt-10 md:pt-14">
    <h2 class="col-span-12 text-display md:col-span-7" data-reveal>{title}</h2>
    <div class="col-span-12 flex flex-col justify-end gap-10 md:col-span-4 md:col-start-9" data-reveal style="--reveal-delay: .08s">
      <p class="max-w-[30rem] text-muted">{text}</p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={href} class="group label inline-flex min-h-12 items-center gap-3 bg-accent px-6 text-bone transition-colors duration-300 hover:bg-accent-hover">
          Projekt anfragen <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
        <a href={`mailto:${site.email}`} class="link-line text-[0.9375rem]">{site.email}</a>
      </div>
    </div>
  </div>
</section>
