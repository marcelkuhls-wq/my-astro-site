---
/** Mehrere Kundenstimmen: ein großes Zitat, darunter weitere im Raster. */
import SectionLabel from '../ui/SectionLabel.astro';
import { testimonials } from '../../data/testimonials';

interface Props {
  ids?: string[];
  class?: string;
}
const { ids, class: className } = Astro.props;
const list = ids ? ids.map((id) => testimonials.find((t) => t.id === id)).filter((t) => t !== undefined) : testimonials;
const [first, ...rest] = list;
const meta = (t: (typeof list)[number]) => [[t.role, t.company].filter(Boolean).join(', '), t.source].filter(Boolean).join(' · ');
---

{
  first && (
    <section class:list={['section-t', className]}>
      <SectionLabel label="Kundenstimmen" />
      <figure class="wrap grid-12 mt-10 gap-y-8 md:mt-14" data-reveal>
        <p class="label col-span-12 text-muted md:col-span-3 md:pt-[0.7em]" aria-hidden="true">★★★★★</p>
        <div class="col-span-12 md:col-span-9 lg:col-span-8">
          <blockquote class="text-h3 !leading-[1.25]"><p>„{first.quote}“</p></blockquote>
          <figcaption class="mt-8 text-[0.9375rem]">
            {first.name}
            {meta(first) && <span class="text-muted"> · {meta(first)}</span>}
          </figcaption>
        </div>
      </figure>
      {
        rest.length > 0 && (
          <div class="wrap mt-16 md:mt-24">
            <ul class="grid gap-x-[var(--gutter)] gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
              {rest.map((t, i) => (
                <li class="border-t border-ink pt-5" data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
                  <blockquote class="text-[1.0625rem] leading-relaxed"><p>„{t.quote}“</p></blockquote>
                  <p class="mt-5 text-[0.875rem]">
                    {t.name}
                    {meta(t) && <span class="block text-muted">{meta(t)}</span>}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  )
}
