---
/**
 * Kundenstimmen als ruhiger Slider: ein Zitat pro Ansicht, wischbar,
 * Pfeile + Punkte, kein Autoplay, keine fremden Skripte.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import { testimonials, splitQuote } from '../../data/testimonials';
import { site } from '../../config/site';

interface Props {
  ids?: string[];
  class?: string;
}
const { ids, class: className } = Astro.props;
const list = ids ? ids.map((id) => testimonials.find((t) => t.id === id)).filter((t) => t !== undefined) : testimonials;
const meta = (t: (typeof list)[number]) => [t.role, t.company].filter(Boolean).join(', ');
---

{
  list.length > 0 && (
    <section class:list={['section-t', className]} data-reviews>
      <SectionLabel label="Kundenstimmen" />
      <div class="wrap grid-12 mt-10 gap-y-8 md:mt-14">
        <div class="col-span-12 flex flex-col gap-5 md:col-span-3">
          {site.google && (
            <a href={site.google.url} target="_blank" rel="noopener" class="group inline-flex flex-col gap-1">
              <span class="font-display text-[2.5rem] leading-none tracking-[-0.03em]">
                {site.google.rating} <span class="text-[1.5rem] align-[0.35em]" aria-hidden="true">★</span>
              </span>
              <span class="label text-muted transition-colors group-hover:text-ink">
                {site.google.count} Google-Bewertungen →
              </span>
            </a>
          )}
          <div class="hidden items-center gap-2 md:flex" aria-hidden="false">
            <button type="button" class="rv-prev label inline-flex size-11 items-center justify-center border border-ink/25 transition-colors hover:border-ink" aria-label="Vorherige Bewertung">←</button>
            <button type="button" class="rv-next label inline-flex size-11 items-center justify-center border border-ink/25 transition-colors hover:border-ink" aria-label="Nächste Bewertung">→</button>
          </div>
        </div>

        <div class="col-span-12 min-w-0 md:col-span-9 lg:col-span-8">
          <ul class="rv-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="Kundenstimmen">
            {list.map((t, i) => (
              <li class="rv-slide w-full shrink-0 snap-start pr-6 md:pr-10" aria-roledescription="Folie" aria-label={`${i + 1} von ${list.length}`}>
                <figure>
                  <blockquote class="text-h3 !leading-[1.25] text-ink/60"><p>„{splitQuote(t)[0]}<span class="text-ink">{splitQuote(t)[1]}</span>{splitQuote(t)[2]}“</p></blockquote>
                  <figcaption class="mt-8 text-[0.9375rem]">
                    {t.name}
                    {meta(t) && <span class="text-muted"> · {meta(t)}</span>}
                    {t.project && (
                      <a href={`/work/${t.project}`} class="link-line ml-3 text-muted hover:text-ink">Zum Projekt</a>
                    )}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
          {list.length > 1 && (
            <div class="mt-8 flex items-center gap-4">
              <div class="flex gap-2">
                {list.map((_, i) => (
                  <button type="button" class="rv-dot h-[3px] w-8 bg-ink/20 transition-colors aria-[current=true]:bg-ink" aria-label={`Bewertung ${i + 1}`} data-i={i} />
                ))}
              </div>
              <div class="ml-auto flex items-center gap-2 md:hidden">
                <button type="button" class="rv-prev label inline-flex size-11 items-center justify-center border border-ink/25" aria-label="Vorherige Bewertung">←</button>
                <button type="button" class="rv-next label inline-flex size-11 items-center justify-center border border-ink/25" aria-label="Nächste Bewertung">→</button>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.rv-track');
    if (!track) return;
    const slides = [...track.querySelectorAll<HTMLElement>('.rv-slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('.rv-dot')];
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[n].offsetLeft - slides[0].offsetLeft, behavior: 'smooth' });
    };
    const mark = () => dots.forEach((d, i) => d.setAttribute('aria-current', String(i === current())));
    root.querySelectorAll('.rv-prev').forEach((b) => b.addEventListener('click', () => go(current() - 1)));
    root.querySelectorAll('.rv-next').forEach((b) => b.addEventListener('click', () => go(current() + 1)));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => requestAnimationFrame(mark), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
    track.tabIndex = 0;
    mark();

    // Automatischer Wechsel alle 8 s – pausiert bei Maus, Fokus, Berührung,
    // wenn der Bereich nicht sichtbar ist oder „Bewegung reduzieren“ aktiv ist.
    if (slides.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let visible = false;
    let paused = false;
    let timer = 0;
    const tick = () => {
      if (visible && !paused && !document.hidden) go(current() + 1);
    };
    const restart = () => {
      clearInterval(timer);
      timer = window.setInterval(tick, 8000);
    };
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(root);
    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = false));
    root.addEventListener('focusin', () => (paused = true));
    root.addEventListener('focusout', () => (paused = false));
    root.addEventListener('touchstart', restart, { passive: true });
    root.querySelectorAll('button').forEach((b) => b.addEventListener('click', restart));
    restart();
  });
</script>
