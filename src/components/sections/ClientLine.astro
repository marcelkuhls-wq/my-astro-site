---
/** Vertrauenszeile: „Projekte u. a. für …“ – Namen aus src/data/clients.ts */
import { clientDirectory, clientNames, press } from '../../data/clients';
import type { ServiceId } from '../../data/services';
import { getProjects } from '../../lib/work';

interface Props {
  /** Anzahl der Namen (Standard: alle) */
  limit?: number;
  /** Nur Kunden mit Projekten in dieser Leistung */
  service?: ServiceId;
  /** Nur die Zeile „Bilder erschienen in“ */
  pressOnly?: boolean;
  class?: string;
}
const { limit, service, pressOnly = false, class: className } = Astro.props;
let all = clientNames;
if (service) {
  const ids = new Set((await getProjects({ service })).map((p) => p.id));
  all = clientDirectory.filter((c) => c.projects.some((id) => ids.has(id))).map((c) => c.name);
}
const names = limit ? all.slice(0, limit) : all;
---

{
  names.length > 0 && (
    <div class:list={['wrap', className]} data-reveal>
      <div class:list={['grid-12 gap-y-3', !pressOnly && 'border-t border-line pt-5']}>
        {!pressOnly && <p class="label col-span-12 text-muted md:col-span-3">Projekte u. a. für</p>}
        {!pressOnly && <p class="col-span-12 text-[0.9375rem] leading-relaxed md:col-span-9">
          {names.map((n, i) => (
            <>
              <span class="whitespace-nowrap">{n}</span>
              {i < names.length - 1 && <> <span class="text-muted" aria-hidden="true">·</span> </>}
            </>
          ))}
        </p>}
        {press.length > 0 && (
          <>
            <p class="label col-span-12 mt-3 text-muted md:col-span-3 md:mt-0">Bilder erschienen in</p>
            <p class="col-span-12 text-[0.9375rem] leading-relaxed md:col-span-9">
              {press.map((p, i) => (
                <>
                  <a href={p.href} target="_blank" rel="noopener" class="link-line" title={p.note}>{p.outlet}</a>
                  {i < press.length - 1 && <> <span class="text-muted" aria-hidden="true">·</span> </>}
                </>
              ))}
            </p>
          </>
        )}
      </div>
    </div>
  )
}
