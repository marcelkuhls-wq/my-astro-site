---
/**
 * Kontaktformular. Mit site.formEndpoint (z. B. Formspree, Web3Forms)
 * wird per POST gesendet. Ohne Endpunkt öffnet sich eine vorbefüllte E-Mail.
 */
import { site } from '../../config/site';

const projectTypes = ['Employer Branding', 'Business & Corporate', 'Immobilien & Interior', 'Event', 'Etwas anderes'];
const budgets = ['bis 1.000 €', '1.000–2.500 €', '2.500–5.000 €', 'über 5.000 €', 'noch offen'];
const sources = ['Google-Suche', 'LinkedIn', 'Empfehlung', 'Instagram', 'Anderes'];
const endpoint = site.formEndpoint;
// Frühestes wählbares Datum (Build-Zeitpunkt; wird im Browser auf heute aktualisiert)
const today = new Date().toISOString().slice(0, 10);

const field =
  'mt-2 block w-full border-0 border-b border-ink/25 bg-transparent px-0 py-2.5 text-[1.0625rem] outline-none transition-[border-color,box-shadow] placeholder:text-ink/35 focus:border-ink focus-visible:shadow-[0_1px_0_0_var(--color-ink)]';
const labelCls = 'label text-muted';
---

<form
  id="contact-form"
  data-clarity-mask="true"
  class="grid-12 gap-y-9"
  method="post"
  action={endpoint || undefined}
  data-mailto={endpoint ? undefined : site.email}
  data-email={site.email}
>
  <div class="col-span-12 md:col-span-6">
    <label for="cf-name" class={labelCls}>Name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required class={field} />
  </div>
  <div class="col-span-12 md:col-span-6">
    <label for="cf-company" class={labelCls}>Unternehmen</label>
    <input id="cf-company" name="unternehmen" type="text" autocomplete="organization" class={field} />
  </div>
  <div class="col-span-12 md:col-span-6">
    <label for="cf-email" class={labelCls}>E-Mail</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required class={field} />
  </div>
  <div class="col-span-12 md:col-span-6">
    <label for="cf-phone" class={labelCls}>Telefon <span class="normal-case tracking-normal">(optional)</span></label>
    <input id="cf-phone" name="telefon" type="tel" autocomplete="tel" class={field} />
  </div>

  <fieldset class="col-span-12">
    <legend class={labelCls}>Art des Projekts</legend>
    <div class="mt-4 flex flex-wrap gap-x-7 gap-y-3">
      {
        projectTypes.map((t, i) => (
          <label class="flex cursor-pointer items-center gap-2.5 text-[1.0625rem]">
            <input type="radio" name="projekt" value={t} required={i === 0} class="size-3.5 accent-ink" />
            {t}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="col-span-12 md:col-span-6">
    <label for="cf-date" class={labelCls}>Wunschtermin <span class="normal-case tracking-normal">(optional)</span></label>
    <input id="cf-date" name="termin" type="date" min={today} class:list={[field, 'date-field']} />
  </div>
  <div class="col-span-12 flex items-end md:col-span-6">
    <label class="flex cursor-pointer items-center gap-2.5 pb-3 text-[1.0625rem]">
      <input type="checkbox" name="flexibel" value="ja" class="size-3.5 accent-ink" />
      Termin ist flexibel
    </label>
  </div>

  <fieldset class="col-span-12">
    <legend class={labelCls}>Budgetrahmen <span class="normal-case tracking-normal">(netto)</span></legend>
    <div class="mt-4 flex flex-wrap gap-x-7 gap-y-3">
      {
        budgets.map((b, i) => (
          <label class="flex cursor-pointer items-center gap-2.5 text-[1.0625rem]">
            <input type="radio" name="budget" value={b} required={i === 0} class="size-3.5 accent-ink" />
            {b}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="col-span-12">
    <label for="cf-message" class={labelCls}>Nachricht</label>
    <textarea id="cf-message" name="nachricht" rows="5" required class:list={[field, 'resize-y']} placeholder="Worum geht es, wofür werden die Bilder gebraucht?"></textarea>
  </div>

  <div class="col-span-12 md:col-span-6">
    <label for="cf-source" class={labelCls}>Wie haben Sie mich gefunden? <span class="normal-case tracking-normal">(optional)</span></label>
    <select id="cf-source" name="quelle" class:list={[field, 'cursor-pointer']}>
      <option value="">Bitte wählen</option>
      {sources.map((q) => <option value={q}>{q}</option>)}
    </select>
  </div>

  {endpoint && <input type="hidden" name="access_key" value={site.formAccessKey} />}

  {/* Honeypot gegen Spam – für Menschen unsichtbar */}
  <div class="hidden" aria-hidden="true">
    <label>Nicht ausfüllen <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="col-span-12 flex flex-col-reverse gap-6 sm:flex-row sm:items-center sm:justify-between">
    <p class="max-w-[28rem] text-[0.8125rem] text-muted">
      Ihre Angaben verwende ich nur zur Bearbeitung der Anfrage. Details in der{' '}
      <a href="/datenschutz" class="link-line">Datenschutzerklärung</a>.
    </p>
    <button type="submit" class="label shrink-0 bg-ink px-8 py-4 text-bone transition-colors hover:bg-black disabled:opacity-50">
      Projekt anfragen
    </button>
  </div>

  <p id="cf-status" class="col-span-12 text-muted" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');

  // Projektart aus dem Link vorauswählen, z. B. /kontakt?projekt=Event
  const preset = new URLSearchParams(window.location.search).get('projekt');
  if (preset && form) {
    const radio = [...form.querySelectorAll<HTMLInputElement>('input[name="projekt"]')].find((r) => r.value === preset);
    if (radio) radio.checked = true;
  }

  // Lead-Trichter: erstes Ausfüllen des Formulars (nur mit Analytics-Zustimmung aktiv)
  const skTrack = (n: string, p: Record<string, unknown> = {}) =>
    (window as unknown as { skTrack?: (n: string, p: Record<string, unknown>) => void }).skTrack?.(n, p);
  form?.addEventListener('focusin', () => skTrack('lead_form_start', { page: location.pathname }), { once: true });

  const dateInput = document.getElementById('cf-date') as HTMLInputElement | null;
  if (dateInput) dateInput.min = new Date().toISOString().slice(0, 10);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('botcheck')) return;

    // Termin lesbar zusammenfassen: "15.05.2027 (flexibel)" – Rohfelder nicht mitsenden
    const raw = String(data.get('termin') || '');
    const flexibel = data.get('flexibel') === 'ja';
    const datum = raw ? new Date(raw + 'T12:00').toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
    const termin = [datum, flexibel ? (datum ? '(flexibel)' : 'flexibel') : ''].filter(Boolean).join(' ') || '–';
    data.delete('termin');
    data.delete('flexibel');
    data.set('wunschtermin', termin);

    const subject = `Projektanfrage: ${data.get('projekt')} – ${data.get('unternehmen') || data.get('name')}`;

    // Ohne Formular-Dienst: vorbefüllte E-Mail im Mailprogramm öffnen
    const mailto = form.dataset.mailto;
    if (mailto) {
      const body = [
        `Name: ${data.get('name')}`,
        `Unternehmen: ${data.get('unternehmen') || '–'}`,
        `E-Mail: ${data.get('email')}`,
        `Telefon: ${data.get('telefon') || '–'}`,
        `Projekt: ${data.get('projekt')}`,
        `Budget: ${data.get('budget') || '–'}`,
        `Gefunden über: ${data.get('quelle') || '–'}`,
        `Wunschtermin: ${termin}`,
        '',
        String(data.get('nachricht')),
      ].join('\n');
      window.location.href = `mailto:${mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      return;
    }

    // Web3Forms
    data.set('subject', subject);
    data.set('from_name', 'Studio Kuhls Website');
    data.set('replyto', String(data.get('email')));
    data.delete('botcheck');

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) status.textContent = 'Wird gesendet …';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);
      // Lead-Ereignis für Google Analytics (nur mit Zustimmung aktiv)
      skTrack('generate_lead', {
        project_type: String(data.get('projekt') ?? ''),
        budget: String(data.get('budget') ?? ''),
        lead_source: String(data.get('quelle') ?? ''),
        transport_type: 'beacon',
      });
      form.reset();
      if (status) status.textContent = 'Danke. Ihre Anfrage ist angekommen – Sie erhalten innerhalb von 24 Stunden (werktags) eine persönliche Rückmeldung.';
      window.location.href = '/danke';
    } catch (err) {
      console.warn('[Kontaktformular]', err);
      if (status)
        status.innerHTML = `Das hat leider nicht geklappt. Bitte schreiben Sie direkt an <a class="link-line" href="mailto:${form.dataset.email}">${form.dataset.email}</a>.`;
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
