---
/**
 * Gallery – editoriale Bildkompositionen. Jede Variante ist ein bewusst
 * gestaltetes Raster, kein Masonry. Auf Mobile stapeln sich die Bilder
 * in voller Breite mit klaren Abständen.
 *
 *  bleed     1 Bild, randlos über die volle Fensterbreite
 *  full      1 Bild, volle Rasterbreite
 *  pair      2 gleich große Bilder nebeneinander
 *  offset    großes Querformat + kleineres Hochformat, versetzt
 *  offset-r  wie offset, gespiegelt
 *  trio      3 Bilder mit wechselnden Höhen (lebendiger, z. B. Events)
 *  single-r  1 Hochformat, rechts im Raster, viel Weißraum links
 */
import Photo from './Photo.astro';
import type { PhotoSpec } from '../../data/photos';

type Item = string | { id: string; spec?: PhotoSpec; position?: string };

interface Props {
  layout: 'bleed' | 'full' | 'pair' | 'offset' | 'offset-r' | 'trio' | 'single-r';
  images: Item[];
  class?: string;
}

const { layout, images, class: className } = Astro.props;
const items = images.map((i) => (typeof i === 'string' ? { id: i } : i));
const [a, b, c] = items;
---

{
  layout === 'bleed' && a && (
    <div class={className}>
      <Photo {...a} ratio="21 / 9" sizes="100vw" drift class="max-md:!aspect-[4/3]" />
    </div>
  )
}

{
  layout !== 'bleed' && (
    <div class:list={['wrap', className]}>
      {layout === 'full' && a && <Photo {...a} ratio="16 / 9" sizes="(min-width: 768px) 94vw, 100vw" class="max-md:!aspect-[4/3]" />}

      {layout === 'pair' && (
        <div class="grid-12 gap-y-[var(--gutter)]">
          {a && <Photo {...a} ratio="4 / 5" sizes="(min-width: 768px) 47vw, 100vw" class="col-span-12 md:col-span-6" />}
          {b && <Photo {...b} ratio="4 / 5" sizes="(min-width: 768px) 47vw, 100vw" class="col-span-12 md:col-span-6" />}
        </div>
      )}

      {(layout === 'offset' || layout === 'offset-r') && (
        <div class="grid-12 items-start gap-y-[var(--gutter)]">
          {a && (
            <Photo
              {...a}
              ratio="3 / 2"
              sizes="(min-width: 768px) 62vw, 100vw"
              class:list={['col-span-12 md:col-span-8', layout === 'offset-r' && 'md:order-2']}
            />
          )}
          {b && (
            <Photo
              {...b}
              ratio="4 / 5"
              sizes="(min-width: 768px) 30vw, 70vw"
              class={
                layout === 'offset-r'
                  ? 'col-span-8 md:order-1 md:col-span-4 md:mt-[32%]'
                  : 'col-span-8 col-start-5 md:col-span-4 md:col-start-auto md:mt-[32%]'
              }
            />
          )}
        </div>
      )}

      {layout === 'trio' && (
        <div class="grid-12 items-start gap-y-[var(--gutter)]">
          {a && <Photo {...a} ratio="4 / 5" sizes="(min-width: 768px) 30vw, 100vw" class="col-span-12 md:col-span-4" />}
          {b && <Photo {...b} ratio="3 / 2" sizes="(min-width: 768px) 38vw, 100vw" class="col-span-12 md:col-span-5 md:mt-[22%]" />}
          {c && <Photo {...c} ratio="3 / 4" sizes="(min-width: 768px) 22vw, 60vw" class="col-span-7 col-start-6 md:col-span-3 md:col-start-auto md:mt-[52%]" />}
        </div>
      )}

      {layout === 'single-r' && a && (
        <div class="grid-12">
          <Photo {...a} ratio="4 / 5" sizes="(min-width: 768px) 40vw, 100vw" class="col-span-12 md:col-span-5 md:col-start-8" />
        </div>
      )}
    </div>
  )
}
