---
/**
 * Cookie-Einwilligung + Google Analytics 4 (+ optional Microsoft Clarity für Heatmaps/Aufzeichnungen).
 *
 * - Ohne Messungs-ID (site.analytics.ga4) passiert gar nichts – kein Banner, kein Skript.
 * - Google Analytics wird erst NACH Zustimmung geladen (vorher keine Verbindung zu Google).
 * - Die Entscheidung wird lokal gespeichert (technisch notwendig, § 25 Abs. 2 TDDDG)
 *   und lässt sich über „Cookie-Einstellungen“ im Footer jederzeit ändern.
 * - Gemessen werden neben Seitenaufrufen die Lead-Signale: Anfrage abgeschickt,
 *   Klicks auf Anfragen/Telefon/E-Mail/LinkedIn, angesehene Projekte.
 */
import { site } from '../../config/site';
const ga4 = site.analytics?.ga4 ?? '';
const clarity = site.analytics?.clarity ?? '';
---

{
  ga4 && (
    <>
      <div
        id="consent"
        class="fixed inset-x-4 bottom-4 z-50 hidden max-w-[30rem] border border-ink/15 bg-bone p-6 shadow-[0_12px_40px_rgba(0,0,0,0.12)] md:left-8 md:right-auto md:bottom-8"
        role="dialog"
        aria-labelledby="consent-title"
        aria-describedby="consent-text"
      >
        <p id="consent-title" class="label text-ink">Datenschutz-Einstellungen</p>
        <p id="consent-text" class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
          Ich würde gern mit {clarity ? 'Google Analytics und Microsoft Clarity' : 'Google Analytics'}{' '}verstehen, welche Inhalte Sie
          interessieren, um die Website zu verbessern. Dafür werden Cookies gesetzt und Daten an {clarity ? 'Google und Microsoft' : 'Google'}{' '}
          übermittelt, auch in die USA. Das passiert nur mit Ihrer Zustimmung, die Sie
          jederzeit widerrufen können. Mehr in der <a href="/datenschutz" class="link-line text-ink">Datenschutzerklärung</a>.
        </p>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <button type="button" data-consent="deny" class="label min-h-11 border border-ink px-4 text-ink transition-colors hover:bg-ink hover:text-bone">
            Ablehnen
          </button>
          <button type="button" data-consent="grant" class="label min-h-11 border border-ink px-4 text-ink transition-colors hover:bg-ink hover:text-bone">
            Akzeptieren
          </button>
        </div>
      </div>

      <script is:inline define:vars={{ ga4, clarity }}>
        (function () {
          var KEY = 'sk-consent';
          var box = document.getElementById('consent');
          var loaded = false;

          function read() {
            try {
              return JSON.parse(localStorage.getItem(KEY) || 'null');
            } catch (e) {
              return null;
            }
          }
          function save(granted) {
            try {
              localStorage.setItem(KEY, JSON.stringify({ analytics: granted, v: 1, ts: Date.now() }));
            } catch (e) {}
          }
          function clearGaCookies() {
            document.cookie.split(';').forEach(function (c) {
              var name = c.split('=')[0].trim();
              if (/^(_ga|_clck|_clsk|CLID)/.test(name)) {
                [location.hostname, '.' + location.hostname.replace(/^www\./, '')].forEach(function (d) {
                  document.cookie = name + '=; Max-Age=0; path=/; domain=' + d;
                });
                document.cookie = name + '=; Max-Age=0; path=/';
              }
            });
          }

          // Ereignisse sammeln, auch bevor GA geladen ist; ohne Zustimmung werden sie verworfen
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.skTrack = function (name, params) {
            if (loaded) window.gtag('event', name, params || {});
          };

          // Seitenbereich für Berichte („Inhaltsgruppe“ in Google Analytics)
          function contentGroup(path) {
            if (document.title.indexOf('Seite nicht gefunden') === 0) return 'Fehlerseite 404';
            path = path.replace(/\.html$/, '').replace(/\/$/, '') || '/';
            if (path === '/') return 'Startseite';
            if (path === '/work') return 'Projektübersicht';
            if (path.indexOf('/work/') === 0) return 'Projekt';
            if (path === '/journal') return 'Journal-Übersicht';
            if (path.indexOf('/journal/') === 0) return 'Journal-Artikel';
            if (/^\/(employer-branding|business-fotografie|immobilienfotografie|eventfotografie|mitarbeiterfotos)$/.test(path)) return 'Leistung';
            if (path === '/kontakt') return 'Kontakt';
            if (path === '/danke') return 'Anfrage gesendet';
            if (path === '/about') return 'Über mich';
            if (path === '/ablauf') return 'Ablauf & Konditionen';
            if (path === '/impressum' || path === '/datenschutz') return 'Rechtliches';
            return 'Sonstiges';
          }

          function load() {
            if (loaded) return;
            loaded = true;
            window.gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'granted',
            });
            window.gtag('js', new Date());
            window.gtag('config', ga4, { content_group: contentGroup(location.pathname) });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
            document.head.appendChild(s);
            if (clarity) {
              // Microsoft Clarity: Heatmaps und Sitzungsaufzeichnungen (Eingabefelder werden maskiert)
              (function (c, l, a, r, i) {
                c[a] = c[a] || function () {
                  (c[a].q = c[a].q || []).push(arguments);
                };
                var t = l.createElement(r);
                t.async = 1;
                t.src = 'https://www.clarity.ms/tag/' + i;
                var y = l.getElementsByTagName(r)[0];
                y.parentNode.insertBefore(t, y);
              })(window, document, 'clarity', 'script', clarity);
              window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'granted' });
            }
            document.dispatchEvent(new Event('sk:analytics'));
          }

          function show() {
            box.classList.remove('hidden');
          }
          function hide() {
            box.classList.add('hidden');
          }

          box.addEventListener('click', function (e) {
            var b = e.target.closest('[data-consent]');
            if (!b) return;
            var granted = b.getAttribute('data-consent') === 'grant';
            save(granted);
            hide();
            if (granted) load();
            else if (loaded) {
              // Widerruf: Cookies löschen, neu laden, damit GA nicht weiterläuft
              clearGaCookies();
              location.reload();
            }
          });
          document.addEventListener('click', function (e) {
            if (e.target.closest('[data-consent-open]')) {
              e.preventDefault();
              show();
            }
          });

          var c = read();
          if (c && c.analytics) load();
          else if (!c) {
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', show);
            else show();
          }
        })();
      </script>

      <script>
        // Lead-Signale: Klicks auf Anfrage-, Telefon-, E-Mail- und externe Links – mit Herkunft auf der Seite
        const track = (name: string, params: Record<string, unknown> = {}) =>
          (window as unknown as { skTrack?: (n: string, p: Record<string, unknown>) => void }).skTrack?.(name, params);
        const where = (el: Element) =>
          el.closest('header') ? 'Kopfzeile' : el.closest('footer') ? 'Footer' : el.closest('#consent') ? 'Banner' : 'Inhalt';
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
          if (!a) return;
          const href = a.getAttribute('href') ?? '';
          const base = { link_text: (a.textContent ?? '').replace(/\s+/g, ' ').trim().slice(0, 60), cta_location: where(a), page: location.pathname };
          if (href.startsWith('/kontakt')) track('cta_click', base);
          else if (href.startsWith('tel:')) track('phone_click', base);
          else if (href.startsWith('mailto:')) track('email_click', base);
          else if (href.includes('linkedin.com')) track('linkedin_click', base);
          else if (href.includes('google.com/maps')) track('reviews_click', base);
          else if (href.startsWith('/work/')) track('select_project', { ...base, project: href.replace('/work/', '').replace(/\.html$/, '') });
        });
        // Angesehene Projekte und Leistungsseiten
        const services: Record<string, string> = {
          'employer-branding': 'Employer Branding',
          'business-fotografie': 'Business & Corporate',
          immobilienfotografie: 'Immobilien & Interior',
          eventfotografie: 'Events',
          mitarbeiterfotos: 'Mitarbeiterfotos',
        };
        const projectView = () => {
          const m = location.pathname.match(/^\/work\/([^/.]+)/);
          if (m) track('view_project', { project: m[1] });
          const s = location.pathname.replace(/^\//, '').replace(/\.html$/, '');
          if (services[s]) track('view_service', { service: services[s] });
        };
        // Kaputte Links finden: Aufruf der 404-Seite mit Herkunft
        if (document.title.indexOf('Seite nicht gefunden') === 0) {
          const nf = () => track('page_not_found', { page: location.pathname, referrer: document.referrer || '(direkt)' });
          document.addEventListener('sk:analytics', nf);
          nf();
        }
        document.addEventListener('sk:analytics', projectView);
        projectView();
      </script>
    </>
  )
}
