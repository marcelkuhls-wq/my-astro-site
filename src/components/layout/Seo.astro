---
import { site } from '../../config/site';

export interface SeoProps {
  /** Seitentitel ohne Markenname – wird zu "Titel | Studio Kuhls" */
  title?: string;
  description: string;
  /** Pfad unter /public, 1200 × 630 */
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Zusätzliche JSON-LD-Objekte (Service, Breadcrumbs, Artikel) */
  schema?: object[];
}

const { title, description, ogImage = '/og-default.jpg', noindex = false, type = 'website', schema = [] } =
  Astro.props as SeoProps;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} – ${site.tagline} in ${site.city}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const ogUrl = new URL(ogImage, Astro.site);

const address = Object.fromEntries(
  Object.entries({
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  }).filter(([, v]) => v),
);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: Astro.site?.toString(),
  image: ogUrl.toString(),
  email: site.email,
  ...(site.phone && { telephone: site.phone }),
  address,
  areaServed: { '@type': 'City', name: 'Hamburg' },
  founder: { '@type': 'Person', name: site.founder, jobTitle: 'Fotograf' },
  knowsAbout: [
    'Employer Branding Fotografie',
    'Business Fotografie',
    'Corporate Fotografie',
    'Immobilienfotografie',
    'Interiorfotografie',
    'Eventfotografie',
  ],
  sameAs: Object.values(site.social).filter(Boolean),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="de_DE" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<meta name="geo.region" content="DE-HH" />
<meta name="geo.placename" content="Hamburg" />

<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
