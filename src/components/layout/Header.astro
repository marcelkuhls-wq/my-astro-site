---
import { nav, site } from '../../config/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 bg-paper/95 transition-transform duration-500 ease-out-soft"
>
  <div class="wrap flex h-[var(--header-h)] items-center justify-between">
    <a href="/" class="sk-logo relative inline-flex min-h-11 items-center gap-[0.32em] font-display text-[1.25rem] leading-none tracking-[0.06em] uppercase md:text-[1.5rem]" aria-label={`${site.name} – Startseite`}>
      {
        [
          { w: 'Studio', cls: 'font-normal', o: 0 },
          { w: 'Kuhls', cls: 'font-semibold', o: 6 },
        ].map(({ w, cls, o }) => (
          <span class:list={['sk-word', cls]} aria-hidden="true">
            {[...w].map((c, i) => (
              <span class="sk-l" style={`--i: ${o + i}`}>{c}</span>
            ))}
          </span>
        ))
      }
    </a>
    <script is:inline>
      // Logo-Intro: auf der Startseite bei jedem Aufruf, auf Unterseiten nur beim Einstieg von außen
      // (ohne Cookies oder Browser-Speicher – entschieden über die vorherige Seite)
      (function (logo) {
        var home = location.pathname === '/' || location.pathname === '/index.html';
        var internal = false;
        try {
          internal = !!document.referrer && new URL(document.referrer).host === location.host;
        } catch (e) {}
        if (home || !internal) {
          logo.classList.add('sk-intro');
          // Nach dem Intro die Klasse entfernen, sonst startet es beim Verlassen des Hovers erneut
          var letters = logo.querySelectorAll('.sk-l');
          letters[letters.length - 1].addEventListener('animationend', function (e) {
            if (e.animationName === 'sk-in') logo.classList.remove('sk-intro');
          });
        }
      })(document.currentScript.previousElementSibling);
    </script>

    <nav aria-label="Hauptnavigation" class="hidden xl:block">
      <ul class="flex items-center gap-x-7 2xl:gap-x-9">
        {
          nav.filter((item) => item.href !== '/kontakt').map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'label relative whitespace-nowrap py-2 transition-opacity duration-300 hover:opacity-100',
                  isActive(item.href) ? 'opacity-100' : 'opacity-75',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/kontakt"
            class:list={[
              'label ml-2 inline-flex items-center gap-2 bg-accent px-4 py-2.5 text-bone transition-colors duration-300 hover:bg-accent-hover',
              isActive('/kontakt') && 'pointer-events-none',
            ]}
          >
            Projekt anfragen <span aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-4 xl:hidden">
      <a href="/kontakt" class="label inline-flex min-h-11 items-center bg-accent px-4 text-bone transition-colors hover:bg-accent-hover">Anfragen</a>
    <button
      type="button"
      id="menu-toggle"
      class="label -mr-2 min-h-11 px-2"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span data-closed>Menü</span>
      <span data-open hidden>Schließen</span>
    </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-[var(--header-h)] bottom-0 hidden flex-col justify-between bg-paper xl:hidden"
  >
    <nav aria-label="Mobile Navigation" class="wrap pt-10">
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block py-1.5 font-display text-[2.125rem] leading-tight tracking-[-0.03em]',
                  !isActive(item.href) && 'text-ink/55',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="wrap pb-10 text-muted">
      <a href={`mailto:${site.email}`} class="block">{site.email}</a>
      {site.phone && <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="block">{site.phone}</a>}
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const setMenu = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    toggle.querySelector('[data-closed]')!.toggleAttribute('hidden', open);
    toggle.querySelector('[data-open]')!.toggleAttribute('hidden', !open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

  // Header beim Runterscrollen ausblenden, beim Hochscrollen zeigen
  let lastY = window.scrollY;
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        const hide = y > lastY && y > 240 && toggle.getAttribute('aria-expanded') !== 'true';
        header.style.transform = hide ? 'translateY(-100%)' : '';
        lastY = y;
        ticking = false;
      });
    },
    { passive: true },
  );
</script>

<style>
  /* Wortmarke: Buchstaben steigen beim ersten Laden gestaffelt aus einer Kante auf;
     beim Überfahren läuft eine kleine Welle durch, darunter zeichnet sich eine feine Linie. */
  .sk-word {
    display: inline-flex;
    overflow: hidden;
    padding-block: 0.22em;
    margin-block: -0.22em;
  }
  .sk-l {
    display: inline-block;
  }
  .sk-intro .sk-l {
    animation: sk-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.15s + var(--i) * 45ms);
  }
  .sk-logo::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) {
    .sk-logo:hover .sk-l {
      animation: sk-wave 0.6s cubic-bezier(0.3, 0.6, 0.3, 1) both;
      animation-delay: calc(var(--i) * 32ms);
    }
    .sk-logo:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }
  @keyframes sk-in {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }
  @keyframes sk-wave {
    0%,
    100% {
      transform: none;
    }
    40% {
      transform: translateY(-0.16em);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-intro .sk-l,
    .sk-logo:hover .sk-l {
      animation: none;
    }
  }
</style>
